+/// Keep the lines the recovery writes in the file [`skyward_sys::LOG`]
+/// names, making its folder first; where that cannot be, in the ramdisk's
+/// own folder, which the next boot takes with it.
+#[cfg(target_os = "android")]
+fn keep_the_log() {
+    let at = Path::new(skyward_sys::LOG);
+    if let Some(folder) = at.parent() {
+        let _ = std::fs::create_dir_all(folder);
+    }
+    if skyward_sys::keep_log(at).is_err() {
+        let _ = std::fs::create_dir_all(skyward_sys::RUN);
+        let _ = skyward_sys::keep_log(Path::new(skyward_sys::RUN).join("recovery.log").as_path());
+    }
+}
