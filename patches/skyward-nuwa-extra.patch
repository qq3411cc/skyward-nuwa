+/// Keep a copy of the log where the system that follows can read it. The
+/// metadata partition is mounted read-only, so it is opened to writing for
+/// the copy and closed again, as the display notes are: the log itself
+/// stays in the ramdisk, which the next boot takes with it.
+#[cfg(target_os = "android")]
+fn mirror_the_log() {
+    std::thread::spawn(|| {
+        let metadata = Path::new("/metadata");
+        let at = metadata.join("skyward/recovery.log");
+        loop {
+            std::thread::sleep(std::time::Duration::from_secs(5));
+            if !skyward_block::mount::is_mount_point(metadata).unwrap_or(false) {
+                continue;
+            }
+            let _ = skyward_block::mount::remount_writable(metadata, true);
+            if let Some(folder) = at.parent() {
+                let _ = std::fs::create_dir_all(folder);
+            }
+            let _ = std::fs::copy(skyward_sys::LOG, &at);
+            let _ = skyward_block::mount::remount_writable(metadata, false);
+        }
+    });
+}
